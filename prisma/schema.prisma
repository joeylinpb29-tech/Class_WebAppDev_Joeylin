generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Buku {
  id        Int      @id @default(autoincrement())
  judul     String
  penulis   String
  kategori  String
  tahun     Int?
  stok      Int      // jumlah total buku (angka kanan pada "3/5")
  tersedia  Int      // jumlah yang sedang ada di rak (angka kiri pada "3/5")
  deskripsi String?
  createdAt DateTime @default(now())
}
